[Unit]
Description=Install remote access secrets on first boot
After=network-online.target
Wants=network-online.target
Before=install-dataplicity.service install-socketxp.service
ConditionPathExists=/usr/local/etc/orcanode-secrets.enc

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/install-secrets.sh
RemainAfterExit=yes
User=root

[Install]
WantedBy=multi-user.target